{
  "title": "A.O. Smith(Ai-Link)",
  "config": {
    "step": {
      "user": {
        "title": "配置 Ai-Link 史密斯",
        "description": "填写您自己的 AI-LiNK App 认证信息。Cookie 与手机号为可选项。",
        "data": {
          "access_token": "访问令牌",
          "user_id": "用户 ID",
          "family_id": "家庭 ID",
          "cookie": "Cookie",
          "mobile": "手机号"
        }
      },
      "reauth_confirm": {
        "title": "更新访问令牌",
        "description": "输入同一账号与家庭的新令牌。验证成功后集成将重新加载。",
        "data": {
          "access_token": "新访问令牌"
        }
      },
      "reconfigure": {
        "title": "替换访问令牌",
        "description": "仅替换令牌，保留已有账号、家庭与设备标识。",
        "data": {
          "access_token": "新访问令牌"
        }
      }
    },
    "error": {
      "no_devices": "未找到支持的设备，请检查认证信息。",
      "auth_error": "认证失败，请检查访问令牌。",
      "cannot_connect": "无法连接到 AI-LiNK 服务。"
    },
    "abort": {
      "reauth_successful": "认证信息已更新。",
      "reconfigure_successful": "配置信息已更新。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Ai-Link 史密斯 选项",
        "description": "调整轮询间隔、语言与原始传感器开关。"
      }
    },
    "data": {
      "update_interval": "更新间隔（秒）",
      "language": "语言",
      "enable_raw_sensors": "为未映射字段启用原始传感器"
    }
  },
