{
  "title": "A.O. Smith(Ai-Link)",
  "config": {
    "step": {
      "user": {
        "title": "Configure Ai-Link A.O. Smith",
        "description": "Enter the credentials from your own AI-LiNK app. Cookie and mobile number are optional.",
        "data": {
          "access_token": "Access token",
          "user_id": "User ID",
          "family_id": "Family ID",
          "cookie": "Cookie",
          "mobile": "Mobile number"
        }
      },
      "reauth_confirm": {
        "title": "Update access token",
        "description": "Enter a new token for the same account and family. The integration will reload after validation.",
        "data": {
          "access_token": "New access token"
        }
      },
      "reconfigure": {
        "title": "Replace access token",
        "description": "Replace only the token. The existing account, family and device identities will be preserved.",
        "data": {
          "access_token": "New access token"
        }
      }
    },
    "error": {
      "no_devices": "No supported devices found with these credentials.",
      "auth_error": "Authentication failed. Please check the access token.",
      "cannot_connect": "Unable to connect to the AI-LiNK service."
    },
    "abort": {
      "reauth_successful": "Authentication updated successfully.",
      "reconfigure_successful": "Configuration updated successfully."
    }
  },
